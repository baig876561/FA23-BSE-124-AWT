# ── DATABASE ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/committee_pro_v3
# OR use Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/committee_pro

# ── SERVER ────────────────────────────────────────
PORT=5000
APP_URL=http://localhost:5000
# For production: APP_URL=https://yoursite.com

# ── SECURITY ──────────────────────────────────────
JWT_SECRET=change_this_to_random_secret_2025

# ── EMAIL (Gmail) ─────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_app_password_here
# Gmail: Enable 2FA → App Passwords → Generate 16-char password → paste here
# App Password URL: https://myaccount.google.com/apppasswords

# ── OPTIONAL ──────────────────────────────────────
# REQUIRE_INVITE=true   # Only allow registration via invite link
